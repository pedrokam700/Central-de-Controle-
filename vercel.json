{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-static.mjs",
  "installCommand": "",
  "outputDirectory": "dist",
  "git": { "deploymentEnabled": { "main": false } },
  "redirects": [
    { "source": "/", "destination": "/Central-de-Controle-/", "permanent": false },
    { "source": "/Central-de-Controle-", "destination": "/Central-de-Controle-/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/Central-de-Controle-/", "destination": "/Central-de-Controle-/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "geolocation=(), payment=(), usb=(), serial=()" }
      ]
    },
    { "source": "/Central-de-Controle-/:path*.mjs", "headers": [{ "key": "Content-Type", "value": "text/javascript; charset=utf-8" }] },
    { "source": "/Central-de-Controle-/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/release-build.json", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/release-identity.json", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/Central-de-Controle-/release-identity.json", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] }
  ]
}
