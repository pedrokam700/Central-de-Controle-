# Central de Trabalho + CORA — V15.1.13.14
# NUNCA coloque valores reais neste arquivo. Copie para .env e preencha localmente.

PORT=8787
AI_DEV_MODE=false

# Firebase Admin — obrigatório para autenticar chamadas da CORA fora do modo DEV
FIREBASE_PROJECT_ID=central-de-controle-88962
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# IA — configure pelo menos o Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_THINKING_LEVEL=medium

# OpenAI — opcional, usado no fallback/verificação quando configurado
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FALLBACK_MODELS=
OPENAI_TRANSCRIBE_MODEL=

# Anthropic — opcional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Pesquisa externa — opcional
TAVILY_API_KEY=

# Ordem de fallback
AI_PROVIDER_ORDER=gemini,openai,anthropic
AI_DUAL_VERIFY=true
AI_DUAL_VERIFY_MODEL=gpt-5.6-terra

# Roteamento econômico por complexidade. Orçamentos em USD; 0 desativa.
AI_ROUTING_ENABLED=true
AI_MODEL_SIMPLE_PROVIDER=gemini
AI_MODEL_SIMPLE=gemini-3.5-flash-lite
AI_MODEL_STANDARD_PROVIDER=gemini
AI_MODEL_STANDARD=gemini-3.6-flash
AI_MODEL_COMPLEX_PROVIDER=openai
AI_MODEL_COMPLEX=gpt-5.6-terra
AI_BUDGET_DAILY_USD=0
AI_BUDGET_MONTHLY_USD=0
AI_BUDGET_PER_USER_MONTHLY_USD=0
AI_BUDGET_DEGRADE_RATIO=0.80
AI_BUDGET_BLOCK_RATIO=1.20

# Segurança / RAG / observabilidade
PII_MASK_EXTERNAL=true
AI_AUDIT_LOGS=true
AI_METRICS_ENABLED=true
RAG_SEMANTIC=true
AI_WEB_MODE=auto
AI_REQUESTS_PER_MINUTE=30
JSON_LIMIT=25mb
CORS_ORIGIN=

AI_PROVIDER_TIMEOUT_MS=12000
AI_REQUEST_DEADLINE_MS=25000
AI_CHAIN_DEADLINE_MS=50000
AI_WEB_TIMEOUT_MS=8000
