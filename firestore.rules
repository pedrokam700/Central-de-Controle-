rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().data.disabled != true;
    }

    function isAdmin() {
      return activeUser() && userProfile().data.role == 'admin';
    }

    match /users/{userId} {
      // O próprio usuário autenticado precisa conseguir consultar se seu perfil
      // existe antes do bootstrap. Listar outros perfis continua exigindo conta ativa.
      allow get: if (signedIn() && request.auth.uid == userId) || activeUser();
      allow list: if activeUser();

      // Bootstrap do próprio perfil após criar/login no Firebase Auth.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.disabled == false
        && (
          request.resource.data.role == 'user'
          || (
            request.resource.data.role == 'admin'
            && request.auth.token.email == 'pedro.henrique@grupomultilaser.com.br'
          )
        );

      // O usuário pode atualizar o próprio perfil, mas não pode se promover
      // nem alterar o estado disabled. Administração continua com o admin.
      allow update: if isAdmin() || (
        activeUser()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.disabled == resource.data.disabled
        && request.resource.data.email == resource.data.email
      );

      allow delete: if isAdmin();
    }

    // Dados de trabalho compartilhados pela equipe autenticada.
    match /products/{documentId} {
      allow read, create, update, delete: if activeUser();
    }

    match /reports/{documentId} {
      allow read, create, update, delete: if activeUser();
    }

    match /operationalFailures/{documentId} {
      allow read, create, update, delete: if activeUser();
    }

    match /activities/{documentId} {
      allow read, create, update, delete: if activeUser();
    }

    match /flows/{documentId} {
      allow read, create, update, delete: if activeUser();
    }

    match /failureAnalyses/{documentId} {
      allow read, create, update, delete: if activeUser();
    }

    match /aiKnowledge/{documentId} {
      allow read, create, update, delete: if activeUser();
    }

    match /aiConversations/{documentId} {
      allow read, create, update, delete: if activeUser();
    }

    // MES v2: private publication namespace per authenticated owner and line.
    // A second PC signs into the same account; no cross-user wildcard access.
    match /amesUsers/{ownerId}/lines/{lineId} {
      function owner() {
        return activeUser() && request.auth.uid == ownerId
          && lineId in ['TAN10101', 'TAN10102', 'TAN10103'];
      }
      function validHead() {
        let d = request.resource.data;
        return d.keys().hasOnly(['schema','owner_uid','line_id','source_id','snapshot_id','snapshot_num','snapshot_revision','key','hash','parts','collected_at'])
          && d.schema == 'central-ames-v2' && d.owner_uid == ownerId && d.line_id == lineId
          && d.source_id is string && d.source_id.size() <= 64
          && d.snapshot_id is string && d.snapshot_num is int && d.snapshot_num > 0
          && d.snapshot_revision is int && d.snapshot_revision > 0
          && d.key is string && d.key.matches('[a-f0-9]{64}')
          && d.hash is string && d.hash.matches('[a-f0-9]{64}')
          && d.parts is int && d.parts > 0 && d.parts <= 5000 && d.collected_at is string;
      }
      allow read: if owner();
      allow create: if owner() && validHead();
      allow update: if owner() && validHead()
        && request.resource.data.source_id == resource.data.source_id
        && (request.resource.data.snapshot_num > resource.data.snapshot_num
          || (request.resource.data.snapshot_num == resource.data.snapshot_num
            && (request.resource.data.snapshot_revision > resource.data.snapshot_revision
              || request.resource.data == resource.data)));
      allow delete: if false;
      match /snapshots/{snapshotKey}/parts/{partId} {
        allow read: if owner();
        allow create: if owner()
          && request.resource.data.keys().hasOnly(['owner_uid','line_id','key','index','data'])
          && request.resource.data.owner_uid == ownerId && request.resource.data.line_id == lineId
          && request.resource.data.key == snapshotKey && snapshotKey.matches('[a-f0-9]{64}')
          && request.resource.data.index is int && request.resource.data.index >= 0
          && request.resource.data.index < 5000
          && request.resource.data.data is string && request.resource.data.data.size() <= 600000;
        allow update: if owner() && request.resource.data == resource.data;
        allow delete: if false;
      }
    }

    // Configuração da Central do Dia: todos os usuários ativos podem ler,
    // somente administradores alteram a estrutura operacional.
    match /workShifts/{documentId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /operationalScopes/{documentId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /workAllocations/{documentId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /routineTemplates/{documentId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    // Execuções são trabalho operacional: usuários autenticados ativos
    // precisam iniciar e concluir as rotinas às quais têm acesso na interface.
    match /routineExecutions/{documentId} {
      allow read, create, update: if activeUser();
      allow delete: if isAdmin();
    }

    // Negação explícita para qualquer coleção não prevista.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
